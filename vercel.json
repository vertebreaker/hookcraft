{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/shorts-hooks", "dest": "/shorts-hooks.html" },
    { "src": "/title-generator", "dest": "/title-generator.html" },
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/sitemap.xml", "dest": "/sitemap.xml" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
